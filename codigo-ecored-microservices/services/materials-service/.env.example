# Puerto e interfaz HTTP de Express.
PORT=8002
HOST=127.0.0.1
# Credenciales del usuario de aplicación de Oracle.
ORACLE_USER=ecored
ORACLE_PASSWORD=CAMBIAR_CLAVE_APP
# Cadena TLS copiada desde OCI Autonomous Database.
ORACLE_CONNECT_STRING=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=HOST_ORACLE))(connect_data=(service_name=SERVICIO_TP))(security=(ssl_server_dn_match=yes)))
# URL privada del microservicio dueño de los datos de Empresas.
COMPANIES_SERVICE_URL=http://127.0.0.1:8001/api
