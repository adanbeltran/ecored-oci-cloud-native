# Puerto local del proxy.
PORT=8080
# En código fuente use 127.0.0.1; el contenedor recibe 0.0.0.0.
HOST=127.0.0.1
# Debe coincidir con VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=reemplace-con-su-project-id
# Claves públicas con las que jose verifica la firma de Firebase.
FIREBASE_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
# Orígenes desde los que el navegador puede llamar al gateway.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Destinos locales de cada ruta.
COMPANIES_URL=http://127.0.0.1:8001
MATERIALS_URL=http://127.0.0.1:8002
