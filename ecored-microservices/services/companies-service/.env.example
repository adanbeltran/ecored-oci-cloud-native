# Puerto HTTP de Django.
PORT=8001
# Clave de Django; use un valor aleatorio en ambientes reales.
DJANGO_SECRET_KEY=solo-para-desarrollo-local
# Active True solo durante desarrollo local.
DJANGO_DEBUG=True
# Hosts desde los que Django aceptará solicitudes.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Orígenes permitidos si se llama al servicio directamente durante diagnóstico.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# URI externa completa de MongoDB; nunca la suba al repositorio.
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER/ecored_companies?retryWrites=true&w=majority
# Base exclusiva del microservicio de Empresas.
MONGODB_DB_NAME=ecored_companies
